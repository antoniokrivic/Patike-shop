{
  "name": "patike-shop-frontend",
  "private": true,
  "version": "1.0.0",
  "description": "TailwindCSS build pipeline for Django static files",
  "scripts": {
    "build:css": "tailwindcss -i ./frontend/src/tailwind.css -o ./static/css/tailwind.css --minify",
    "watch:css": "tailwindcss -i ./frontend/src/tailwind.css -o ./static/css/tailwind.css --watch"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.1",
    "tailwindcss": "^3.4.17"
  }
}
