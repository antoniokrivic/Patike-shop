# Rename this file to .env and fill in your Supabase credentials
# For local development you can leave it empty to keep using SQLite.

# PostgreSQL connection string provided by Supabase
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
SUPABASE_DB_URL=

# SSL mode for database connections (leave as require for Supabase)
DATABASE_SSLMODE=require

# Example allowed hosts configuration for production
# ALLOWED_HOSTS=your-domain.com,another-domain.com

# Firebase Storage
# Putanja do service account JSON-a (relativno na korijen projekta)
FIREBASE_SERVICE_ACCOUNT_PATH=firebase-credentials.json
# Naziv Firebase Storage bucket-a
FIREBASE_STORAGE_BUCKET=patike-shop.firebasestorage.app
# 1=public URL, 0=signed URL
FIREBASE_STORAGE_PUBLIC=1
